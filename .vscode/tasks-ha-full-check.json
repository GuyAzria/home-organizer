{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "HA: Full Check",
      "type": "shell",
      "command": "python",
      "args": [
        "tools/ha_full_check.py",
        "--root",
        ".",
        "--json",
        "reports/ha-full-check.json"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "HA: Full Check + External Tools",
      "type": "shell",
      "command": "python",
      "args": [
        "tools/ha_full_check.py",
        "--root",
        ".",
        "--run-external",
        "--json",
        "reports/ha-full-check.json"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "HA: Full Check + Pytest",
      "type": "shell",
      "command": "python",
      "args": [
        "tools/ha_full_check.py",
        "--root",
        ".",
        "--run-external",
        "--run-tests",
        "--json",
        "reports/ha-full-check.json"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "HA: Full Check (auto on workspace open)",
      "type": "shell",
      "command": "python",
      "args": [
        "tools/ha_full_check.py",
        "--root",
        ".",
        "--json",
        "reports/ha-full-check.json"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "runOptions": {
        "runOn": "folderOpen"
      }
    }
  ]
}
